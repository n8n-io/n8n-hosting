# Example environment variables for deploying n8n
# Do NOT commit real secrets to the repository. Use Render Secrets or another secret manager.

# Postgres connection string example (Render Managed Postgres or external):
DATABASE_URL=postgres://user:password@host:5432/dbname

# Basic auth (recommended to protect n8n web UI)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Public URL where Render will serve your service (used for webhooks)
WEBHOOK_URL=https://your-render-url.onrender.com/

# n8n host/port/protocol (Render usually handles these automatically)
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
