matches the snapshot:
  1: |
    raw: |
      n8n has been successfully deployed!

      To access n8n, run the following commands:

      1. Get the service URL:
         kubectl get service RELEASE-NAME-n8n-main --namespace NAMESPACE

      2. Port forward to access n8n locally:
         kubectl port-forward service/RELEASE-NAME-n8n-main --namespace NAMESPACE 5678:5678

      3. Open your browser to:
         http://localhost:5678

      Deployment Configuration:
        - Mode: Queue (2 workers)
        - Main pods: 1
        - Database: PostgreSQL (your-postgres-hostname)
        - Cache: Redis (your-redis-hostname)

      Documentation: https://docs.n8n.io/
      Issues: https://github.com/n8n-io/n8n-hosting/issues
  2: |
    apiVersion: v1
    data:
      DB_POSTGRESDB_DATABASE: n8n
      DB_POSTGRESDB_HOST: your-postgres-hostname
      DB_POSTGRESDB_PORT: "5432"
      DB_POSTGRESDB_SCHEMA: public
      DB_POSTGRESDB_USER: n8n
      DB_TYPE: postgresdb
      EXECUTIONS_MODE: queue
      N8N_GRACEFUL_SHUTDOWN_TIMEOUT: "30"
      N8N_PORT: "5678"
      OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS: "true"
      QUEUE_BULL_REDIS_HOST: your-redis-hostname
      QUEUE_BULL_REDIS_PORT: "6379"
      QUEUE_BULL_REDIS_TIMEOUT_THRESHOLD: "10000"
      QUEUE_WORKER_LOCK_DURATION: "60000"
      QUEUE_WORKER_LOCK_RENEW_TIME: "10000"
      QUEUE_WORKER_MAX_STALLED_COUNT: "1"
      QUEUE_WORKER_STALLED_INTERVAL: "30000"
      TZ: UTC
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: n8n
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: n8n-0.0.0
      name: RELEASE-NAME-n8n
      namespace: NAMESPACE
  3: |
    apiVersion: v1
    data:
      EXECUTIONS_DATA_HARD_DELETE_BUFFER: "1"
      EXECUTIONS_DATA_MAX_AGE: "336"
      EXECUTIONS_DATA_PRUNE: "true"
      EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL: "15"
      EXECUTIONS_DATA_PRUNE_MAX_COUNT: "10000"
      EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL: "60"
      EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS: "true"
      EXECUTIONS_DATA_SAVE_ON_ERROR: all
      EXECUTIONS_DATA_SAVE_ON_PROGRESS: "false"
      EXECUTIONS_DATA_SAVE_ON_SUCCESS: all
      EXECUTIONS_TIMEOUT_MAX: "3600"
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: main
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: n8n
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: n8n-0.0.0
      name: RELEASE-NAME-n8n-main
      namespace: NAMESPACE
  4: |
